{
  "name": "chds-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "https": "local-ssl-proxy --source 443 --target 3000 --cert ./certs/localhost.crt --key ./certs/localhost.key & next dev -p 3000",
    "build": "next build",
    "start": "node server.js",
    "start:dev": "next dev -p 3000",
