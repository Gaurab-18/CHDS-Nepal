    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
