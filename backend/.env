# ═══════════════════════════════════════════════════
# CHDS Nepal — Backend Environment Configuration
# ═══════════════════════════════════════════════════
# Copy .env.example to .env and fill in your values.
# Never commit real secrets to version control.
# ═══════════════════════════════════════════════════

NODE_ENV=development
PORT=4000

# ── PostgreSQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chds_db
DB_USER=postgres

# App database user (restricted RBAC role, not superuser)
APP_USER=app_user
APP_USER_PASSWORD=change_me_app_user_password

# ── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT Secrets ─────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=put-your-64-char-hex-random-jwt-secret-here-xxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=put-another-64-char-hex-random-refresh-secret-here-xxxxxxxxxxxx
SESSION_SECRET=put-a-64-char-hex-random-session-secret-here-xxxxxxxxxxxxxxxxxxx

# ── AES-256 PHI Encryption Key ──────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=put-your-64-char-hex-aes-256-key-here-xxxxxxxxxxxxxxxxxxxxxxxx

# ── SSL (optional — HTTP fallback if missing) ───────
SSL_KEY_PATH=/etc/ssl/certs/server.key
SSL_CERT_PATH=/etc/ssl/certs/server.crt

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=info

# ── SMTP (Email) ────────────────────────────────────
# Defaults to Mailpit (localhost:1025) for development.
# For Gmail, uncomment the lines below and generate an App Password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Gmail SMTP (uncomment and fill, then comment out Mailpit above):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=CHDS <noreply@chds.np>

# ── Frontend URL (for email links) ──────────────────
FRONTEND_URL=https://localhost

# ── Rate Limiting ──────────────────────────────────
DISABLE_RATE_LIMIT=false
